(require '[hive-photocraft.portability :as portability])
(let [{:keys [passes failures]} (hive-photocraft.portability/run-checks)]
  (println "cljrs portability:" passes "checks," (count failures) "failures")
  (doseq [failure failures] (println "FAIL" failure))
  (when (seq failures) (throw (ex-info "Portability divergence" {:failures failures}))))
